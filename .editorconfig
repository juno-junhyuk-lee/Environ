# Shared editor settings, respected by most editors (VS Code needs the
# "EditorConfig" extension). See https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python: 4 spaces (PEP 8, matches Ruff).
[*.py]
indent_size = 4

[*.toml]
indent_size = 4

# Markdown: trailing double spaces can mean a line break.
[*.md]
trim_trailing_whitespace = false

# Makefiles require tabs.
[Makefile]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf
